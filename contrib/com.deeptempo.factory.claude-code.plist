<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.deeptempo.factory.claude-code</string>
  <key>ProgramArguments</key>
  <array><string>/Users/armstrongflg/vigil-factory/contrib/tick-claude-code.sh</string></array>
  <key>WorkingDirectory</key><string>/Users/armstrongflg/vigil-factory</string>
  <!-- Every 2 hours; the worker's usage gate, not the interval, keeps it under
       the subscription's limits. A true interval, not a clock schedule, so the
       spacing never collapses at midnight. A tick still running when the next
       is due makes that one skip. -->
  <key>StartInterval</key><integer>7200</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/armstrongflg/vigil-factory/telemetry/launchd.stdout.log</string>
  <key>StandardErrorPath</key><string>/Users/armstrongflg/vigil-factory/telemetry/launchd.stderr.log</string>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
